{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "capacitor.config.ts", "tests/db/**/*.ts", "src/features/progression/**/*.ts"]
}
