# Public client config only. Never put the service_role key or other secrets here:
# every VITE_* variable is embedded into the client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Recognition model manifest JSON (see docs/ADR-001). Leave empty until a trained model is published.
# Without it the scanner reports "recognition unavailable" (no fake success).
VITE_RECOGNITION_MODEL_URL=

# Comma-separated OAuth providers enabled in Supabase Auth, e.g. google,apple
VITE_AUTH_OAUTH_PROVIDERS=

# Privacy policy page linked on the sign-in screen (https). Empty = text without a link.
VITE_PRIVACY_POLICY_URL=

# Test sign-in by phone: no SMS, this code always works and unknown numbers are registered.
# Unset = 1111; "off" = real SMS codes. Anyone who knows a number can enter its account — turn off before release.
VITE_PHONE_FIXED_CODE=1111

# Dev only: use mock camera/geolocation/recognition. Ignored in production builds.
VITE_USE_MOCKS=false

# Yandex Maps JavaScript API 3.0 key (developer.tech.yandex.ru). Public by design, protected by the
# HTTP Referer restriction set in the developer console (localhost for dev). Real value goes to .env only.
VITE_YANDEX_MAPS_API_KEY=
